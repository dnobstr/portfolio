# Supabase Project Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Override Vite base path (defaults to / in dev, /portfolio/ in production)
# Set to / if deploying to a custom domain on GitHub Pages.
# VITE_BASE_PATH=/portfolio/
